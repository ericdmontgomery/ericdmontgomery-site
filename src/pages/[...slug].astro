---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import NowSlot from '../components/NowSlot.astro';

// One page is built for every Markdown file in the "pages" collection.
// The Home page's file is home.md, but its address is "/", so its slug is left empty.
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { slug: page.id === 'home' ? undefined : page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const isHome = page.id === 'home';
const title = isHome ? 'Eric D. Montgomery' : `${page.data.title} · Eric D. Montgomery`;
---
<Base title={title} page={page.id} theme={page.data.theme}>
  {isHome && (
    // The hub frame: the permanent name, then the one slot that changes per book.
    <div class="masthead">
      <p class="masthead-name">Eric D. Montgomery</p>
      <NowSlot />
    </div>
  )}
  <article class="prose">
    <Content />
  </article>
</Base>
